# Dockerfile for LiveKit Agent Worker (separate service)
FROM python:3.11-slim

WORKDIR /app

# System deps for building some Python wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only PyTorch first
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout=300 --retries=3 --index-url https://download.pytorch.org/whl/cpu torch

# Copy backend requirements and install
COPY backend/requirements.txt /app/backend/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout=300 --retries=3 -r /app/backend/requirements.txt

# Copy backend source
COPY backend /app/backend

# Pre-download Silero VAD model during build
RUN python3 -c "import sys; sys.path.insert(0, '/app/backend'); \
    import os; \
    os.environ['TRANSFORMERS_VERBOSITY'] = 'error'; \
    os.environ['HF_HUB_DISABLE_PROGRESS_BARS'] = '1'; \
    from pipecat.audio.vad.silero import SileroVADAnalyzer; \
    print('Downloading Silero VAD model...'); \
    vad = SileroVADAnalyzer(); \
    print('✅ VAD model downloaded and cached')" || \
    (echo "⚠️  VAD model download failed, will download on first use" && exit 0)

# Default envs
ENV PYTHONUNBUFFERED=1 \
    ENVIRONMENT=production \
    PYTHONPATH=/app/backend \
    PORT=8080

# Expose port for Cloud Run health checks (agent doesn't use it, but Cloud Run requires it)
EXPOSE 8080

# Agent worker with health check server
# Cloud Run requires a service to listen on PORT, so we run both:
# 1. Simple HTTP health check server on PORT (for Cloud Run)
# 2. Bot worker (connects to LiveKit Cloud)
CMD ["bash", "-lc", "python3 -m http.server ${PORT:-8080} --bind 0.0.0.0 > /dev/null 2>&1 & python -m bot.main start"]

